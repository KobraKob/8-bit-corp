# Pixel Corp Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
# Comma-separated browser origins. Keep production origins explicit.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
DATABASE_URL=sqlite+aiosqlite:///pixel_corp.sqlite

# LLM Providers (Groq Free Tier: 30 RPM, 6k TPM per key)
LLM_PROVIDER=mock
# Set LLM_PROVIDER=groq and add a valid key to use Groq instead.
# Set LLM_PROVIDER=openai_compatible and provide OPENAI_API_KEY for the configured OpenAI endpoint.
# Set LLM_PROVIDER=ollama for a local Ollama server; edit tier model IDs in config/models.yaml.
OPENAI_API_KEY=
OLLAMA_API_KEY=local
GROQ_API_KEY=your_groq_api_key_here
# GROQ_API_KEYS=gsk_key1,gsk_key2
# GROQ_MANAGER_KEYS=gsk_manager1,gsk_manager2

# Storage
WORKSPACES_ROOT=./workspaces
