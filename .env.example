# Pixel Corp Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database
DATABASE_URL=sqlite+aiosqlite:///pixel_corp.sqlite

# LLM Providers (Groq Free Tier: 30 RPM, 6k TPM per key)
# 1. Single default key:
GROQ_API_KEY=your_groq_api_key_here

# 2. General multi-key pool (comma-separated 5-10 keys for general rotation):
# GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3,gsk_key4,gsk_key5

# 3. Dedicated manager keys (allocated with top priority for CEO, CTO, Level <= 3):
# GROQ_MANAGER_KEYS=gsk_mgr1,gsk_mgr2,gsk_mgr3
# Optional external search keys (if using Tavily/Brave later)
# TAVILY_API_KEY=
# BRAVE_API_KEY=

# Storage
WORKSPACES_ROOT=./workspaces
