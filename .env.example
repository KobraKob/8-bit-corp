# Pixel Corp Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database
DATABASE_URL=sqlite+aiosqlite:///pixel_corp.sqlite

# LLM Providers
GROQ_API_KEY=your_groq_api_key_here
